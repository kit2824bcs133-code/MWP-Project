{
  "name": "online-exam-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:server:dev\" \"vite\"",
    "server:dev": "node --watch --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
